# Generate real values with:  cd backend && python -m scripts.gen_keys
SECRET_KEY=change-me-at-least-32-characters-long-xxxxxxxx
ENCRYPTION_KEY=                      # base64 of 32 random bytes (AES-GCM for phone/email/tokens)
HMAC_KEY=change-me-at-least-32-characters-long-xxxxxxxx
POSTGRES_PASSWORD=app

# Meta (see README, "Meta setup")
META_APP_SECRET=                     # signs webhooks (X-Hub-Signature-256); can be overridden per channel in the dashboard
META_VERIFY_TOKEN=                   # the string you type into Meta's "Verify token" box
GRAPH_API_VERSION=v21.0              # bump when Meta retires it
PUBLIC_BASE_URL=https://your-domain.example

DEFAULT_PHONE_REGION=BD
EMBEDDING_DIM=1024                   # pgvector column size; changing it needs a migration and re-embedding
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
# Main application (docs/INTEGRATION.md): programs + form links come from it, leads go to it. Empty = not connected.
MAIN_APP_API_URL=
MAIN_APP_API_KEY=
MAIN_APP_PUBLIC_URL=
# Single sign-on: the same secret is set in the main app (ASSISTANT_SSO_SECRET); empty = off.
SSO_SHARED_SECRET=
SSO_ISSUER=main-app
# The dashboard may be shown inside these sites (space-separated origins), e.g. https://app.example.org
FRAME_ANCESTORS=
# Used when running without Docker (docker-compose overrides these):
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/assistant
REDIS_URL=redis://localhost:6379/0
